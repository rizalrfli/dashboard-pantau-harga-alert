---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Analisa AI — Screener AI"
  description="Analisa AI rule-based semua saham watchlist IDX: arah bull/bear, saran masuk, dan scalping."
  active="analisa"
  searchPlaceholder="Cari di tabel analisa…"
>

      <div class="page-head">
        <h1>Analisa AI</h1>
        <div class="sub">Analisa rule-based semua saham di watchlist — arah bull/bear, saran masuk, scalping, dan rekomendasi swing &amp; hold 1-3 bulan. Data Yahoo Finance, refresh otomatis 60 detik.</div>
        <div id="lastUpdate" class="sub"></div>
      </div>
      <div id="globalError" class="err hidden"></div>

      <section class="summary">
        <div class="sum-card">
          <div class="sum-label">Boleh masuk hari ini</div>
          <div class="sum-value" id="sumMasuk">—</div>
          <div class="sum-sub" id="sumMasukSub">Jalankan Analisa Semua Saham</div>
        </div>
        <div class="sum-card">
          <div class="sum-label">Cocok untuk scalping</div>
          <div class="sum-value" id="sumScalp">—</div>
          <div class="sum-sub" id="sumScalpSub">Jalankan Analisa Semua Saham</div>
        </div>
        <div class="sum-card">
          <div class="sum-label">Swing &amp; hold 1-3 bln</div>
          <div class="sum-value" id="sumSwing">—</div>
          <div class="sum-sub" id="sumSwingSub">Jalankan Analisa Semua Saham</div>
        </div>
      </section>

      <div class="toolbar">
        <button id="btnNotif">Aktifkan notifikasi</button>
        <button id="btnAnalyzeAll" class="primary">Analisa Semua Saham</button>
      </div>

      <div id="aiSummary" class="panel ai-summary"><p class="muted">Belum dianalisa. Tekan "Analisa Semua Saham" untuk menganalisa semua saham di watchlist.</p></div>
      <div id="aiPanel" class="ai-panel hidden"></div>

      <section class="panel" id="scan911Section" style="margin-top:16px">
        <h2 style="margin-bottom:8px">Analisa Semua Saham IDX (911)</h2>
        <p class="muted">Scan seluruh 911 saham IDX dengan analisa AI yang sama seperti watchlist (skor 0–100, verdict BULLISH/NETRAL/BEARISH, saran Masuk/Tunggu/Wait and See/Hindari, plus daftar scalping) — bukan cuma 8 saham watchlist. Daftar "boleh masuk" dan "scalping" di bawah ini dihitung dari 911 saham, terpisah dari daftar watchlist di atas.</p>
        <p class="muted"><b>Batasan yang jujur:</b> scan penuh butuh beberapa menit karena Yahoo membatasi kecepatan; data Yahoo Finance delay ~10–15 menit; volume hari ini masih sebagian di tengah sesi bursa — paling akurat setelah market close. Saham yang gagal dimuat tidak diberi skor karangan: jumlahnya ditampilkan dan bisa dipindai ulang.</p>
        <div class="toolbar">
          <button id="btnScan911" class="primary">Mulai Scan 911 Saham</button>
          <button id="btnStop911" disabled>Stop</button>
          <button id="btnRetry911" class="hidden">Coba lagi yang gagal</button>
        </div>
        <div id="scan911Progress" class="hidden">
          <div class="row"><b id="scan911Status">Memindai…</b><span class="muted" id="scan911Eta"></span></div>
          <div class="progress"><i id="scan911Bar" style="width:0%"></i></div>
          <div class="mini" id="scan911Detail"></div>
        </div>
        <div id="scan911Meta" class="mini" style="margin-top:8px">Belum ada hasil scan 911 saham.</div>
        <div id="scan911Results" class="ai-summary">
          <b>Belum dipindai</b>
          <p class="muted">Tekan "Mulai Scan 911 Saham" — analisa memindai 911 saham IDX dalam batch kecil, hasilnya muncul bertahap dari skor tertinggi. Hasilnya disimpan untuk hari ini, jadi kunjungan berikutnya langsung tampil tanpa scan ulang.</p>
        </div>
      </section>

      <footer>Data dari Yahoo Finance, bisa delay ~15 menit. Bukan rekomendasi investasi — selalu cek lagi sebelum membeli atau menjual saham.</footer>
    
</BaseLayout>

<script>
import { fmtRp, fmtPct, analyzeStock, analyzeScalping, analyzeSwing, fmtVol, fmtTurn, verdictBadge, suggestionBadge, swingBadge } from "../lib/ai.js";
import { stockLogoHTML } from "../lib/logos.js";
import { renderAiPanel } from "../lib/analysisPanel.js";
import { swingSectionHTML } from "../lib/swingPanel.js";
import { IDX_TICKERS } from "../lib/tickers.js";

const LS = { watch:"idx_watchlist" };
const $ = s => document.querySelector(s);
const DEFAULT_WATCH = ["BBCA","BBRI","BMRI","BBNI","TLKM","ASII","GOTO","AMRT"];
function load(k, d){ try{ const v=JSON.parse(localStorage.getItem(k)); return v??d; }catch(e){ return d; } }
let watch = load(LS.watch, DEFAULT_WATCH);
let prices = {};
let analysis = {};

async function apiQuote(symbols){
  const r = await fetch("/api/quote?symbols=" + symbols.map(encodeURIComponent).join(","));
  if(!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}
async function refreshQuotes(){
  if(!watch.length) return;
  try{
    const data = await apiQuote(watch.map(c=>c+".JK"));
    data.results.forEach(q=>{ prices[q.symbol]=q; });
    const mts = data.results.map(q=>q.marketTime).filter(Boolean).map(t=>new Date(t).getTime()).filter(n=>!isNaN(n));
    const now = new Date();
    const fmtTime = d => d.toLocaleTimeString("id-ID",{timeZone:"Asia/Jakarta", hour:"2-digit", minute:"2-digit"});
    if(mts.length){
      const latest = Math.max(...mts);
      const delayMin = Math.max(0, Math.round((now.getTime()-latest)/60000));
      const el = $("#lastUpdate");
      el.textContent = `Data bursa per ${fmtTime(new Date(latest))} WIB • telat ${delayMin} mnt • dicek ${fmtTime(now)} WIB`;
      el.style.color = delayMin > 15 ? "#d97706" : "";
    } else {
      $("#lastUpdate").textContent = "Terakhir dicek: " + fmtTime(now) + " WIB (jam data bursa tidak tersedia)";
    }
  }catch(e){
    const el=$("#globalError"); el.textContent="Gagal memuat harga: "+e.message+". Coba refresh lagi."; el.classList.remove("hidden");
  }
}


async function analyzeAll(){
  const btn=$("#btnAnalyzeAll");
  if(!watch.length){ alert("Watchlist kosong — tambah saham dulu."); return; }
  btn.disabled=true;
  const panel=$("#aiSummary");
  panel.classList.remove("hidden");
  const rows=[];
  for(let i=0;i<watch.length;i++){
    const code=watch[i];
    btn.textContent=`Menganalisa… ${i+1}/${watch.length} (${code})`;
    panel.innerHTML=`<b>Analisa Semua</b><p class="muted">Menganalisa ${code} (${i+1}/${watch.length})…</p>`;
    try{
      const r=await fetch(`/api/chart?symbol=${code}.JK&range=3mo`);
      if(!r.ok) throw new Error("HTTP "+r.status);
      const d=await r.json();
      const a=analyzeStock(code, d.closes||[], prices[code+".JK"]);
      analysis[code]=a;
      const scalp=analyzeScalping(code, d.volumes||[], prices[code+".JK"], a);
      const swing=analyzeSwing(code, d.closes||[], prices[code+".JK"], a);
      rows.push({code, a, scalp, swing});
    }catch(e){ console.warn("analisa gagal", code, e); }
  }
  btn.disabled=false; btn.textContent="Analisa Semua Saham";
  if(!rows.length){ panel.innerHTML="<b>Analisa Semua</b><p class='muted'>Gagal menganalisa semua saham — coba refresh lalu ulangi.</p>"; return; }
  rows.sort((x,y)=>y.a.score-x.a.score);
  const bull=rows.filter(r=>r.a.verdict==="BULLISH").length;
  const bear=rows.filter(r=>r.a.verdict==="BEARISH").length;
  const net=rows.length-bull-bear;
  const best=rows[0];
  // --- 1) Saham yang boleh masuk hari ini (kriteria ketat, jangan dipaksa) ---
  const bolehMasuk=rows.filter(({a})=>
    a.verdict==="BULLISH" && a.score>=65
    && a.rsi!=null && a.rsi>=40 && a.rsi<=65
    && a.ma20!=null && a.ma50!=null && a.price>a.ma20 && a.price>a.ma50
    && a.macdHist!=null && a.macdHist>0
    && (a.changePercent??0)>=0
  ).sort((x,y)=>y.a.score-x.a.score);
  // --- 2) Cocok untuk scalping (skor scalping terpisah) ---
  const scalpers=rows.filter(r=>r.scalp?.eligible).sort((x,y)=>y.scalp.score-x.scalp.score);
  // --- 3) Rekomendasi swing & hold 1-3 bulan ---
  const swingList=rows.filter(r=>r.swing?.classification==="SWING").sort((x,y)=>y.swing.swingScore-x.swing.swingScore);
  const holdList=rows.filter(r=>r.swing?.classification==="HOLD").sort((x,y)=>y.swing.swingScore-x.swing.swingScore);
  // --- Kartu ringkasan di atas ---
  const sm=$("#sumMasuk"), ss=$("#sumScalp");
  if(sm){ sm.textContent = bolehMasuk.length ? bolehMasuk.length + " saham" : "0 saham"; }
  const sms=$("#sumMasukSub"); if(sms) sms.textContent = bolehMasuk.length ? bolehMasuk.map(r=>r.code).join(", ") : "Tidak ada yang lolos hari ini";
  if(ss){ ss.textContent = scalpers.length ? scalpers.length + " saham" : "0 saham"; }
  const sss=$("#sumScalpSub"); if(sss) sss.textContent = scalpers.length ? scalpers.map(r=>r.code).join(", ") : "Tidak ada yang cocok hari ini";
  const sw=$("#sumSwing"); if(sw){ sw.textContent = (swingList.length+holdList.length) ? (swingList.length+holdList.length) + " saham" : "0 saham"; }
  const sws=$("#sumSwingSub"); if(sws) sws.textContent = (swingList.length||holdList.length) ? [...swingList.map(r=>r.code+" (swing)"), ...holdList.map(r=>r.code+" (hold)")].join(", ") : "Tidak ada rekomendasi swing/hold";
  panel.innerHTML = `
    <b>Analisa Semua — ${rows.length} saham</b>
    <p class="muted">${bull} bullish, ${net} netral, ${bear} bearish — paling kuat ${best.code} (skor ${best.a.score}, ${best.a.verdict}, saran: ${best.a.suggestion}). Saran "Wait and See (WNS)" = sinyal masih bertentangan/netral, jangan masuk dulu, tunggu konfirmasi tembus resistance/MA20; "Tunggu" = sudah bullish tapi RSI ≥70, tunggu koreksi ke MA20.</p>
    <div class="tablewrap"><table>
      <thead><tr><th>Kode</th><th>Harga</th><th>%</th><th>RSI</th><th>MA20 / MA50</th><th>MACD</th><th>Skor</th><th>Arah</th><th>Saran</th></tr></thead>
      <tbody>${rows.map(({code,a})=>`<tr>
        <td data-label="Kode"><span style="display:flex;gap:8px;align-items:center">${stockLogoHTML(code, 28)}<b>${code}</b></span></td>
        <td data-label="Harga">${fmtRp(a.price)}</td>
        <td data-label="%" class="${(a.changePercent||0)>=0?"up":"down"}">${fmtPct(a.changePercent)}</td>
        <td data-label="RSI">${a.rsi==null?"—":a.rsi.toFixed(1)}</td>
        <td data-label="MA20 / MA50">${fmtRp(a.ma20)} / ${fmtRp(a.ma50)}</td>
        <td data-label="MACD">${a.macdHist==null?"—":(a.macdHist>=0?"+":"")+Math.round(a.macdHist)}</td>
        <td data-label="Skor"><b>${a.score}</b></td>
        <td data-label="Arah">${verdictBadge(a)}</td>
        <td data-label="Saran">${suggestionBadge(a.suggestion)}</td>
      </tr>`).join("")}</tbody>
    </table></div>
    <h3 style="margin-top:16px">Saham yang boleh masuk hari ini</h3>
    <p class="mini">Kriteria lolos (semua harus terpenuhi): verdict BULLISH, skor ≥65, RSI 40-65 (tidak overbought), harga di atas MA20 dan MA50, MACD histogram positif, dan % harian tidak negatif. Diurutkan dari skor tertinggi.</p>
    ${bolehMasuk.length ? `<div class="tablewrap"><table>
      <thead><tr><th>Kode</th><th>Skor</th><th>RSI</th><th>Entry</th><th>Stop loss</th><th>Target 1</th><th>Target 2</th></tr></thead>
      <tbody>${bolehMasuk.map(({code,a})=>`<tr>
        <td data-label="Kode"><span style="display:flex;gap:8px;align-items:center">${stockLogoHTML(code, 28)}<b>${code}</b></span></td><td data-label="Skor"><b>${a.score}</b></td><td data-label="RSI">${a.rsi.toFixed(1)}</td>
        <td data-label="Entry">${a.entry}</td><td data-label="Stop loss">${fmtRp(a.stopLoss)}</td><td data-label="Target 1">${fmtRp(a.target1)}</td><td data-label="Target 2">${fmtRp(a.target2)}</td>
      </tr>`).join("")}</tbody>
    </table></div>` : `<p><b>Hari ini tidak ada saham yang lolos kriteria masuk — semua WNS/Hindari.</b> Jangan paksa masuk; tunggu sampai ada saham yang memenuhi semua kriteria di atas.</p>`}
    <h3 style="margin-top:16px">Cocok untuk scalping</h3>
    <p class="mini">Kriteria lolos: range harian (high-low)/prev close minimal 1,5%, likuiditas tinggi (volume ≥5 jt lembar dan turnover ≥Rp5 miliar), RSI 45-65, MACD positif, harga di atas MA20. Skor scalping 0-100: range +30, likuiditas +25, RSI +20, MACD +15, di atas MA20 +10. Scalping = trading cepat dalam sehari: pakai stop loss ketat, jangan tahan lama, dan jangan kejar harga.</p>
    ${scalpers.length ? `<div class="tablewrap"><table>
      <thead><tr><th>Kode</th><th>Range harian</th><th>Volume</th><th>RSI</th><th>Skor scalping</th><th>Catatan</th></tr></thead>
      <tbody>${scalpers.map(({code,a,scalp})=>`<tr>
        <td data-label="Kode"><span style="display:flex;gap:8px;align-items:center">${stockLogoHTML(code, 28)}<b>${code}</b></span></td>
        <td data-label="Range harian">${scalp.rangePct==null?"—":scalp.rangePct.toFixed(1)+"%"}</td>
        <td data-label="Volume"><span class="cell-val">${fmtVol(scalp.volume)}<br><span class="muted">turnover ${fmtTurn(scalp.turnover)}</span></span></td>
        <td data-label="RSI">${a.rsi==null?"—":a.rsi.toFixed(1)}</td>
        <td data-label="Skor scalping"><b>${scalp.score}</b></td>
        <td data-label="Catatan" style="min-width:260px">${scalp.note}</td>
      </tr>`).join("")}</tbody>
    </table></div>` : `<p><b>Hari ini tidak ada saham yang cocok untuk scalping.</b> Range harian terlalu kecil, likuiditas kurang, atau RSI/MACD tidak mendukung — lebih aman tidak scalping hari ini.</p>`}
    ${swingSectionHTML(swingList, holdList, "watchlist", true)}
    <p class="mini">Klik baris saham di tabel ringkasan untuk melihat alasan detail + rencana entry di panel Analisa AI di bawah. Semua analisa di atas rule-based dari data Yahoo Finance (delay ~10-15 menit) — bukan rekomendasi investasi dan bukan prediksi pasti.</p>`;
  // Klik baris di tabel ringkasan -> panel analisa per saham di bawah
  panel.querySelectorAll(".tablewrap table tbody tr").forEach(tr=>{
    tr.style.cursor="pointer";
    tr.addEventListener("click", ()=>openDetailAI(tr.querySelector("td b")?.textContent?.trim()));
  });
}

async function openDetailAI(code){
  if(!code) return;
  const el=$("#aiPanel");
  el.classList.remove("hidden");
  el.innerHTML="<p class='muted'>Memuat analisa "+code+"…</p>";
  try{
    const r=await fetch(`/api/chart?symbol=${code}.JK&range=3mo`);
    if(!r.ok) throw new Error("HTTP "+r.status);
    const d=await r.json();
    const a=analyzeStock(code, d.closes||[], prices[code+".JK"]);
    analysis[code]=a;
    renderAiPanel(code, a);
    el.scrollIntoView({behavior:"smooth"});
  }catch(e){ el.innerHTML="<p class='muted'>Gagal memuat analisa "+code+": "+e.message+"</p>"; }
}
// ---- Scan 911 saham: analisa AI untuk semua saham IDX ----
// Pola yang sama seperti Whale Detector (src/pages/whale.astro):
// batch 5 paralel, jeda 150ms antar batch, retry sekali per ticker,
// Stop kapan saja, hasil disimpan per hari perdagangan (localStorage)
// supaya kunjungan berikutnya langsung tampil. Satu ticker yang gagal
// dimuat dicatat sebagai "terlewat" dan TIDAK diberi skor karangan.
// Data chart diambil dari /api/chart (range 3mo — butuh 50+ hari untuk
// MA50/MACD); data harian (dayHigh/dayLow/volume) diambil dari /api/quote
// per batch karena /api/chart tidak mengembalikan high/low harian —
// tanpa itu kriteria scalping (range harian, volume, turnover) tidak
// bisa dihitung. Bila /api/quote gagal, fallback ke data chart (harga
// terakhir + volume terakhir); range harian jadi tidak tersedia sehingga
// saham itu otomatis tidak lolos scalping — tidak pernah dikarang.
const SCAN911 = { batch: 5, delayMs: 150, retryMs: 700, cacheKey: "screener_scan911_v1" };
let scan911Results = [];   // {code, a, scalp} — a = hasil analyzeStock, scalp = analyzeScalping
let scan911Skipped = [];   // kode yang gagal dimuat (tanpa skor)
let scan911Scanning = false, scan911Stop = false;
let scan911StartedAt = null, scan911Done = 0, scan911Total = 0;

function scan911TodayKey(){ return new Date().toLocaleDateString("en-CA", { timeZone: "Asia/Jakarta" }); }
function loadScan911Cache(){
  try{
    const c = JSON.parse(localStorage.getItem(SCAN911.cacheKey));
    if(c && c.date === scan911TodayKey() && Array.isArray(c.results)) return c;
  }catch(e){}
  return null;
}
// Cache lama (sebelum fitur swing) tidak menyimpan swing — hitung dari
// hasil analisa yang tersimpan (tanpa closes: tren 3 bulan pakai proksi skor).
function backfillSwing911(){
  for(const r of scan911Results){
    if(!r.swing && r.a) r.swing = analyzeSwing(r.code, null, null, r.a);
  }
}
// Cache disimpan ringkas (tanpa reasons/riskNote — panel detail per saham
// menghitung ulang dari data segar saat baris diklik) supaya 911 hasil
// muat di localStorage.
function saveScan911Cache(){
  try{
    localStorage.setItem(SCAN911.cacheKey, JSON.stringify({
      date: scan911TodayKey(), scannedAt: new Date().toISOString(),
      results: scan911Results.map(({code, a, scalp, swing})=>{
        const {reasons, riskNote, ...rest} = a || {};
        return { code, a: rest, scalp, swing };
      }),
      skipped: scan911Skipped, total: IDX_TICKERS.length
    }));
  }catch(e){ /* localStorage penuh: hasil tetap tampil, cuma tidak tersimpan */ }
}
function fmtClock911(d){ return d.toLocaleTimeString("id-ID", { timeZone: "Asia/Jakarta", hour: "2-digit", minute: "2-digit" }); }

async function fetchChart911(code){
  const r = await fetch(`/api/chart?symbol=${encodeURIComponent(code + ".JK")}&range=3mo`);
  if(!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}
async function fetchChart911Retry(code){
  try { return await fetchChart911(code); }
  catch(e){
    await new Promise(res => setTimeout(res, SCAN911.retryMs));
    return fetchChart911(code); // retry sekali; bila masih gagal, caller mencatat skipped
  }
}
async function fetchQuotes911(codes){
  try{
    const r = await fetch("/api/quote?symbols=" + codes.map(c => encodeURIComponent(c + ".JK")).join(","));
    if(!r.ok) return {};
    const d = await r.json();
    const map = {};
    (d.results || []).forEach(q => { map[q.symbol.replace(/\.JK$/, "")] = q; });
    return map;
  }catch(e){ return {}; }
}

// Kriteria "boleh masuk hari ini" — SAMA seperti daftar watchlist di atas.
function isDailyEntry911(a){
  return a.verdict === "BULLISH" && a.score >= 65
    && a.rsi != null && a.rsi >= 40 && a.rsi <= 65
    && a.ma20 != null && a.ma50 != null && a.price > a.ma20 && a.price > a.ma50
    && a.macdHist != null && a.macdHist > 0
    && (a.changePercent ?? 0) >= 0;
}

function setScan911Progress(){
  const pct = scan911Total ? Math.round(scan911Done / scan911Total * 100) : 0;
  $("#scan911Bar").style.width = pct + "%";
  $("#scan911Status").textContent = scan911Scanning ? `Memindai ${scan911Done}/${scan911Total} saham (${pct}%)` : `Scan selesai: ${scan911Done}/${scan911Total} saham`;
  const elapsed = scan911StartedAt ? (Date.now() - scan911StartedAt) / 1000 : 0;
  const rate = elapsed > 0 ? scan911Done / elapsed : 0;
  const remain = rate > 0 ? Math.max(0, (scan911Total - scan911Done) / rate) : 0;
  $("#scan911Eta").textContent = scan911Scanning && remain > 0 ? ` • kira-kira ${Math.ceil(remain / 60)} mnt lagi (rata-rata ${rate.toFixed(1)} saham/detik)` : "";
  $("#scan911Detail").textContent = `${scan911Results.filter(r => r.a.verdict === "BULLISH").length} bullish • ${scan911Results.filter(r => r.a.verdict === "BEARISH").length} bearish • ${scan911Skipped.length} terlewat • berjalan ${Math.round(elapsed)} detik`;
}

function renderScan911(){
  const el = $("#scan911Results");
  const filter = $("#scan911Filter") ? $("#scan911Filter").value : "ALL";
  const bull = scan911Results.filter(r => r.a.verdict === "BULLISH").length;
  const bear = scan911Results.filter(r => r.a.verdict === "BEARISH").length;
  const net = scan911Results.length - bull - bear;
  const thin = scan911Results.filter(r => r.a.rsi == null).length; // data <20 hari -> WNS (skor 50, bukan karangan: itu fallback resmi ai.js)
  const best = scan911Results[0];
  const cache = loadScan911Cache();
  const when = cache ? "Hasil scan terakhir " + fmtClock911(new Date(cache.scannedAt)) + " WIB (data hari ini)" : "";
  $("#scan911Meta").textContent = (scan911Results.length
    ? `${scan911Results.length} saham berhasil dianalisa • ${bull} bullish • ${net} netral • ${bear} bearish • ${scan911Skipped.length} terlewat (tanpa data / dibatasi Yahoo)${thin ? ` • ${thin} saham data kurang dari 20 hari (otomatis WNS)` : ""}`
    : "Belum ada hasil scan 911 saham.")
    + (when ? " • " + when : "") + (scan911Scanning ? " • Scan masih berjalan…" : "");
  $("#btnRetry911").classList.toggle("hidden", !scan911Skipped.length || scan911Scanning);

  if(!scan911Results.length){
    el.innerHTML = `<b>${scan911Scanning ? "Memindai…" : "Belum ada hasil"}</b><p class="muted">${scan911Scanning ? "Hasil muncul bertahap dari skor tertinggi." : "Tekan \"Mulai Scan 911 Saham\" untuk memulai."}</p>`;
    return;
  }
  const filtered = scan911Results.filter(r => filter === "ALL" || r.a.verdict === filter);
  const bolehMasuk911 = scan911Results.filter(({a}) => isDailyEntry911(a)).sort((x, y) => y.a.score - x.a.score);
  const scalpers911 = scan911Results.filter(r => r.scalp?.eligible).sort((x, y) => y.scalp.score - x.scalp.score);
  // Swing & hold dari 911 saham (fallback: hitung dari hasil analisa tersimpan bila cache lama belum punya swing).
  const withSwing911 = scan911Results.map(r => ({ ...r, swing: r.swing || (r.a ? analyzeSwing(r.code, null, null, r.a) : null) }));
  const swing911 = withSwing911.filter(r => r.swing?.classification === "SWING").sort((x, y) => y.swing.swingScore - x.swing.swingScore);
