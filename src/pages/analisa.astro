async function runScan911(force, onlyCodes){
  if(scan911Scanning) return;
  const codes = (onlyCodes && onlyCodes.length) ? onlyCodes : IDX_TICKERS.map(t => t.code);
  if(!force && !onlyCodes){
    const c = loadScan911Cache();
    if(c){ // hasil hari ini sudah ada: tampilkan, jangan scan ulang otomatis
      scan911Results = c.results; scan911Skipped = c.skipped || []; scan911Done = c.total;
      backfillSwing911();
      renderScan911();
      $("#btnScan911").textContent = "Scan Ulang 911 Saham";
      return;
    }
  }
  const isRetry = !!(onlyCodes && onlyCodes.length);
  scan911Scanning = true; scan911Stop = false;
  if(!isRetry){ scan911Results = []; scan911Skipped = []; scan911Done = 0; }
  else { scan911Skipped = []; } // retry: yang gagal dicatat ulang; yang berhasil ditambahkan ke hasil lama
  scan911Total = codes.length;
  scan911StartedAt = Date.now();
  $("#btnScan911").disabled = true; $("#btnStop911").disabled = false;
  $("#btnScan911").textContent = "Memindai…";
  $("#scan911Progress").classList.remove("hidden");
  renderScan911();
  for(let i = 0; i < codes.length; i += SCAN911.batch){
    if(scan911Stop) break;
    const batch = codes.slice(i, i + SCAN911.batch);
    const quotesP = fetchQuotes911(batch); // 1 panggilan /api/quote untuk 5 kode sekaligus
    const settled = await Promise.all(batch.map(async code => {
      try{
        const d = await fetchChart911Retry(code);
        const closes = (d.closes || []).filter(v => v != null);
        if(!closes.length) return { ok: false, code }; // tidak ada data: terlewat, tanpa skor
        const quotes = await quotesP;
        const q = quotes[code] || null;
        const lastClose = closes[closes.length - 1];
        const lastVol = (d.volumes || []).filter(v => v != null).pop() ?? null;
        const quote = q || { price: lastClose, previousClose: d.previousClose ?? null,
          changePercent: (d.previousClose && d.previousClose !== 0) ? (lastClose - d.previousClose) / d.previousClose * 100 : null,
          volume: lastVol, dayHigh: null, dayLow: null };
        const a = analyzeStock(code, d.closes || [], quote);
        const scalp = analyzeScalping(code, d.volumes || [], quote, a);
        const swing = analyzeSwing(code, d.closes || [], quote, a);
        return { ok: true, code, a, scalp, swing };
      }catch(e){ return { ok: false, code }; }
    }));
    for(const r of settled){
      if(r.ok){
        const ix = scan911Results.findIndex(x => x.code === r.code);
        if(ix >= 0) scan911Results[ix] = r; else scan911Results.push(r);
      } else scan911Skipped.push(r.code);
      scan911Done++;
    }
    scan911Results.sort((x, y) => y.a.score - x.a.score);
    setScan911Progress();
    renderScan911();
    if(i + SCAN911.batch < codes.length && !scan911Stop){
      await new Promise(res => setTimeout(res, SCAN911.delayMs));
    }
  }
  scan911Scanning = false;
  $("#btnScan911").disabled = false; $("#btnStop911").disabled = true;
  $("#btnScan911").textContent = "Scan Ulang 911 Saham";
  setScan911Progress();
  renderScan911();
  saveScan911Cache();
}

