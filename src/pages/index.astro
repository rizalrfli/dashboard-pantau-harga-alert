---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Screener AI — Pantau Saham IDX"
  description="Pantau harga saham IDX, alert, dan analisa AI rule-based dari data Yahoo Finance."
  active="watch"
  onIndex
  searchDropdown
>

      <div class="page-head">
        <h1>Pantau Saham IDX</h1>
        <div class="sub">Harga &amp; alert + analisa AI — data Yahoo Finance • refresh otomatis 60 detik</div>
        <div id="lastUpdate" class="sub"></div>
      </div>
      <div id="globalError" class="err hidden"></div>

      <section class="summary">
        <div class="sum-card">
          <div class="sum-label">IHSG • Indeks Harga Saham Gabungan</div>
          <div id="ihsg" class="ihsg"><span class="muted">Memuat IHSG…</span></div>
        </div>
      </section>

      <div class="toolbar">
        <button id="btnNotif">Aktifkan notifikasi</button>
        <button id="btnGoAnalisa" type="button">Analisa Semua Saham</button>
      </div>

      <div class="tabs">
        <button data-tab="watch" class="active">Watchlist</button>
        <button data-tab="alerts">Alert <span id="alertCount"></span></button>
        <button data-tab="port">Portofolio</button>
      </div>

      <!-- WATCHLIST -->
      <section id="tab-watch">
        <form class="inline" id="addForm">
          <div><label>Kode saham</label><input id="addCode" placeholder="BBCA" maxlength="6" style="text-transform:uppercase"></div>
          <button type="submit" class="primary">Tambah saham</button>
        </form>
        <p class="sub">Populer: <span id="chips"></span></p>
        <div id="watchLoading" class="empty">Memuat harga…</div>
        <div id="watchEmpty" class="empty hidden">Watchlist kosong. Tambah kode saham di atas, misalnya BBCA.</div>
        <div class="grid" id="watchGrid"></div>

        <div id="detail" class="panel hidden">
          <div class="row"><h2 id="detailTitle" style="margin:0;font-size:18px">Detail</h2><button id="detailClose" aria-label="Tutup detail">Tutup</button></div>
          <div class="range-row">
            <button data-range="1mo">1 bln</button>
            <button data-range="3mo" class="primary">3 bln</button>
            <button data-range="6mo">6 bln</button>
          </div>
          <canvas id="chart" width="900" height="220"></canvas>
          <div class="stat" id="detailStats"></div>
          <p class="mini" id="detailNote"></p>
          <div id="aiPanel" class="ai-panel hidden"></div>
        </div>
      </section>

      <!-- ALERTS -->
      <section id="tab-alerts" class="hidden">
        <div class="panel">
          <h2 style="margin-top:0">Buat alert</h2>
          <form class="inline" id="alertForm">
            <div><label>Kode</label><input id="alCode" placeholder="BBCA" maxlength="6" style="text-transform:uppercase"></div>
            <div><label>Jenis</label><select id="alType"><option value="above">Harga ≥ (di atas)</option><option value="below">Harga ≤ (di bawah)</option><option value="pct_up">Naik ≥ % harian</option><option value="pct_down">Turun ≥ % harian</option></select></div>
            <div><label>Nilai (Rp / %)</label><input id="alValue" type="number" step="any" placeholder="5500" ></div>
            <button type="submit" class="primary">Simpan alert</button>
          </form>
        </div>
        <h3>Alert aktif</h3>
        <div id="alertList"></div>
        <h3>Alert yang terpicu</h3>
        <div id="trigList"><p class="muted">Belum ada alert yang terpicu.</p></div>
      </section>

      <!-- PORTFOLIO -->
      <section id="tab-port" class="hidden">
        <div class="panel">
          <h2 style="margin-top:0">Tambah posisi (manual)</h2>
          <form class="inline" id="portForm">
            <div><label>Kode</label><input id="pfCode" placeholder="BBCA" maxlength="6" style="text-transform:uppercase"></div>
            <div><label>Lot (1 lot = 100 lbr)</label><input id="pfLot" type="number" min="1" step="1" placeholder="10" ></div>
            <div><label>Harga beli / lembar (Rp)</label><input id="pfPrice" type="number" min="1" step="any" placeholder="4900" ></div>
            <button type="submit" class="primary">Simpan posisi</button>
          </form>
        </div>
        <div class="panel" style="margin-top:12px">
          <div class="row"><b>Total nilai &amp; P/L</b><b id="portTotal">—</b></div>
          <div class="tablewrap"><table>
            <thead><tr><th>Kode</th><th>Lot</th><th>Beli</th><th>Terakhir</th><th>P/L</th><th></th></tr></thead>
            <tbody id="portBody"></tbody>
          </table></div>
        </div>
      </section>

      <footer>Data dari Yahoo Finance, bisa delay ~15 menit. Bukan rekomendasi investasi — selalu cek lagi sebelum membeli atau menjual saham.</footer>
    
</BaseLayout>

<script>
import { fmtRp, fmtPct, fmtNum, sma, rsi, analyzeStock, verdictBadge, suggestionBadge } from "../lib/ai.js";
import { IDX_TICKERS } from "../lib/tickers.js";
import { stockLogoHTML } from "../lib/logos.js";
import { renderAiPanel } from "../lib/analysisPanel.js";

const DEFAULT_WATCH = ["BBCA","BBRI","BMRI","BBNI","TLKM","ASII","GOTO","AMRT"];
const POPULAR = ["BBCA","BBRI","BMRI","BBNI","TLKM","ASII","GOTO","AMRT","ICBP","UNVR","ANTM","BRPT"];
const LS = { watch:"idx_watchlist", alerts:"idx_alerts", trig:"idx_triggered", port:"idx_portfolio" };
const $ = s => document.querySelector(s);

function load(k, d){ try{ const v=JSON.parse(localStorage.getItem(k)); return v??d; }catch(e){ return d; } }
function save(k, v){ localStorage.setItem(k, JSON.stringify(v)); }

let watch = load(LS.watch, DEFAULT_WATCH);
let alerts = load(LS.alerts, []);
let triggered = load(LS.trig, []);
let portfolio = load(LS.port, []);
let prices = {}; // symbol -> quote
let selected = null, selectedRange = "3mo";
let searchTerm = "";

function showTab(name){
  document.querySelectorAll(".tabs button").forEach(b=>b.classList.toggle("active", b.dataset.tab===name));
  document.querySelectorAll(".side-btn").forEach(b=>b.classList.toggle("active", b.dataset.tab===name));
  ["watch","alerts","port"].forEach(t=>$("#tab-"+t).classList.toggle("hidden", t!==name));
  if(name==="port") renderPortfolio();
  if(name==="alerts") renderAlerts();
}
document.querySelectorAll(".tabs button").forEach(b=>b.addEventListener("click", ()=>showTab(b.dataset.tab)));
document.querySelectorAll(".side-btn[data-tab]").forEach(b=>b.addEventListener("click", ()=>showTab(b.dataset.tab)));
$("#topSearch").addEventListener("input", e=>{ searchTerm=e.target.value; renderWatch(); renderSearchDrop(); });
function renderSearchDrop(){
  const drop=$("#searchDrop"), input=$("#topSearch");
  const term=(input.value||"").trim().toUpperCase();
  if(term.length<2 || typeof IDX_TICKERS==="undefined"){ drop.classList.add("hidden"); input.setAttribute("aria-expanded","false"); return; }
  const hits=IDX_TICKERS.filter(t=>t.code.includes(term)||t.name.toUpperCase().includes(term)).slice(0,8);
  if(!hits.length){ drop.classList.add("hidden"); input.setAttribute("aria-expanded","false"); return; }
  drop.innerHTML="";
  hits.forEach(t=>{
    const b=document.createElement("button"); b.type="button"; b.setAttribute("role","option");
    const inWatch=watch.includes(t.code);
    b.innerHTML=`<span style="display:flex;gap:8px;align-items:center;min-width:0">${stockLogoHTML(t.code, 28)}<b>${t.code}</b></span><span>${t.name}</span><span class="${inWatch?"in-watch":""}">${inWatch?"Sudah di watchlist":"Tambah"}</span>`;
    b.onclick=()=>{
      if(!watch.includes(t.code)){ watch.push(t.code); save(LS.watch,watch); renderWatch(); refreshAll(); }
      input.value=""; searchTerm=""; renderWatch(); drop.classList.add("hidden"); input.setAttribute("aria-expanded","false");
    };
    drop.appendChild(b);
  });
  drop.classList.remove("hidden"); input.setAttribute("aria-expanded","true");
}
document.addEventListener("click", e=>{ if(!e.target.closest(".search-wrap")) $("#searchDrop").classList.add("hidden"); });
$("#topSearch").addEventListener("keydown", e=>{ if(e.key==="Escape"){ $("#searchDrop").classList.add("hidden"); } });

async function apiQuote(symbols){
  const r = await fetch("/api/quote?symbols=" + symbols.map(encodeURIComponent).join(","));
  if(!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}

async function refreshAll(){
  $("#globalError").classList.add("hidden");
  $("#watchLoading").classList.remove("hidden");
  try{
    const symbols = ["^JKSE", ...watch.map(c=>c+".JK")];
    const data = await apiQuote(symbols);
    data.results.forEach(q=>{ prices[q.symbol]=q; });
    if(data.errors?.length) console.warn("quote errors", data.errors);
    renderIhsg(); renderWatch(); checkAlerts(); renderPortfolio();
    // Jam terakhir update = marketTime terbaru dari Yahoo (bukan jam fetch),
    // supaya kelihatan data bursanya per jam berapa dan telat berapa menit.
    const mts = data.results.map(q=>q.marketTime).filter(Boolean).map(t=>new Date(t).getTime()).filter(n=>!isNaN(n));
    const latest = mts.length ? Math.max(...mts) : null;
    const now = new Date();
    const fmtTime = d => d.toLocaleTimeString("id-ID",{timeZone:"Asia/Jakarta", hour:"2-digit", minute:"2-digit"});
    if(latest){
      const delayMin = Math.max(0, Math.round((now.getTime()-latest)/60000));
      const el = $("#lastUpdate");
      el.textContent = `Data bursa per ${fmtTime(new Date(latest))} WIB • telat ${delayMin} mnt • dicek ${fmtTime(now)} WIB`;
      el.style.color = delayMin > 15 ? "#d97706" : "";
      el.title = "marketTime terbaru dari Yahoo Finance; delay = jam sekarang minus jam data bursa";
    } else {
      $("#lastUpdate").textContent = "Terakhir dicek: " + fmtTime(now) + " WIB (jam data bursa tidak tersedia)";
    }
  }catch(e){
    const el=$("#globalError"); el.textContent="Gagal memuat harga: "+e.message+". Coba refresh lagi."; el.classList.remove("hidden");
  }finally{ $("#watchLoading").classList.add("hidden"); }
}

function renderIhsg(){
  const q = prices["^JKSE"];
  const el = $("#ihsg");
  if(!q){ el.innerHTML='<span class="muted">IHSG tidak tersedia</span>'; return; }
  const cls = (q.changePercent||0)>=0 ? "up":"down";
  const mt = q.marketTime ? new Date(q.marketTime).toLocaleTimeString("id-ID",{timeZone:"Asia/Jakarta", hour:"2-digit", minute:"2-digit"}) : null;
  el.innerHTML = `<span><b>IHSG</b></span><span><b>${fmtNum(q.price)}</b></span>
    <span class="${cls}">${fmtPct(q.changePercent)} (${q.change!=null?(q.change>=0?"+":"")+Math.round(q.change).toLocaleString("id-ID"):"—"})</span>
    <span class="muted">Tertinggi ${fmtNum(q.dayHigh)} • Terendah ${fmtNum(q.dayLow)} • Vol ${fmtNum(q.volume)}</span>
    ${mt ? `<span class="muted">Data per ${mt} WIB</span>` : ""}`;
}

function renderWatch(){
  const grid = $("#watchGrid"); grid.innerHTML="";
  const term = (searchTerm||"").trim().toUpperCase();
  const list = watch.filter(code=>{
    if(!term) return true;
    const q = prices[code+".JK"];
    return code.includes(term) || (q?.longName||"").toUpperCase().includes(term);
  });
  const emptyEl = $("#watchEmpty");
  emptyEl.classList.toggle("hidden", list.length>0);
  if(!list.length){
    emptyEl.textContent = term ? "Tidak ada saham yang cocok dengan pencarian." : "Watchlist kosong. Tambah kode saham di atas, misalnya BBCA.";
  }
  list.forEach(code=>{
    const sym = code+".JK", q = prices[sym];
    const div = document.createElement("div"); div.className="card";
    div.onclick = ()=>openDetail(code);
    if(!q){ div.innerHTML=`<div class="row card-head"><span class="card-id">${stockLogoHTML(code)}<span class="sym">${code}</span></span><button class="del" title="Hapus">✕</button></div><p class="card-note">Harga belum tersedia — coba refresh.</p>`; }
    else{
      const cls=(q.changePercent||0)>=0?"up":"down";
      const a=analysis[code];
      div.innerHTML=`<div class="row card-head"><span class="card-id">${stockLogoHTML(code)}<span class="sym">${code}</span></span><button class="del" title="Hapus">✕</button></div>
        <div class="name">${q.longName||""}</div>
        <div class="row card-price"><span class="price ${cls}">${fmtRp(q.price)}</span><span class="${cls}"><b>${fmtPct(q.changePercent)}</b></span></div>
        <div class="card-meta">
          <div><small>Tertinggi</small><b>${fmtRp(q.dayHigh)}</b></div>
          <div><small>Terendah</small><b>${fmtRp(q.dayLow)}</b></div>
          <div><small>Volume</small><b>${fmtNum(q.volume)}</b></div>
          <div><small>Prev close</small><b>${fmtRp(q.previousClose)}</b></div>
        </div>
        ${a ? `<div class="card-badges">${verdictBadge(a)} ${suggestionBadge(a.suggestion)}</div>` : `<div class="card-note">Belum dianalisa — jalankan Analisa Semua Saham atau buka detail saham ini.</div>`}`;
    }
    div.querySelector(".del").onclick = e=>{ e.stopPropagation(); watch=watch.filter(c=>c!==code); save(LS.watch,watch); renderWatch(); refreshAll(); };
    grid.appendChild(div);
  });
}

function renderChips(){
  $("#chips").innerHTML="";
  POPULAR.forEach(c=>{ const s=document.createElement("span"); s.className="chip"; s.textContent=c;
    s.onclick=()=>{ if(!watch.includes(c)){ watch.push(c); save(LS.watch,watch); renderWatch(); refreshAll(); } };
    $("#chips").appendChild(s); });
}
renderChips();

$("#addForm").addEventListener("submit", e=>{
  e.preventDefault();
  const code=$("#addCode").value.trim().toUpperCase().replace(/\.JK$/,"");
  if(!/^[A-Z0-9]{2,6}$/.test(code)) return;
  if(!watch.includes(code)){ watch.push(code); save(LS.watch,watch); }
  $("#addCode").value=""; renderWatch(); refreshAll();
});
$("#btnRefresh").addEventListener("click", refreshAll);
$("#btnNotif").addEventListener("click", async ()=>{
  if(!("Notification" in window)) return alert("Browser ini tidak mendukung notifikasi.");
  const p = await Notification.requestPermission();
  alert(p==="granted" ? "Notifikasi diaktifkan." : "Notifikasi: "+p);
});
$("#detailClose").addEventListener("click", ()=>{ $("#detail").classList.add("hidden"); selected=null; });
document.querySelectorAll("[data-range]").forEach(b=>b.addEventListener("click", ()=>{
  selectedRange=b.dataset.range;
  document.querySelectorAll("[data-range]").forEach(x=>x.classList.toggle("primary", x===b));
  if(selected) openDetail(selected, true);
}));

// ---- Detail + chart + indikator ----
let analysis = {}; // kode -> hasil analyzeStock (dari Analisa Semua / detail)
let lastCloses = null; // closes terakhir, untuk menggambar ulang grafik saat lebar layar berubah
function drawChart(canvas, closes){
  // Ukuran bitmap mengikuti lebar kartu x devicePixelRatio (tajam di HP retina),
  // gambar digambar ulang dalam satuan CSS px.
  // Warna dibaca dari token CSS (bukan hardcode) supaya grafik ikut tema
  // gelap — dulu garis grid #e5e7eb dan teks #64748b akan hilang di latar gelap.
  const cssVars=getComputedStyle(document.documentElement);
  const gridCol=cssVars.getPropertyValue("--line").trim()||"#e5e7eb";
  const mutedCol=cssVars.getPropertyValue("--muted").trim()||"#64748b";
  const blueCol=cssVars.getPropertyValue("--blue").trim()||"#2563eb";
  const dpr=window.devicePixelRatio||1;
  const cssW=canvas.clientWidth||900, cssH=canvas.clientHeight||220;
  canvas.width=Math.round(cssW*dpr); canvas.height=Math.round(cssH*dpr);
  const ctx=canvas.getContext("2d");
  ctx.setTransform(dpr,0,0,dpr,0,0);
  const W=cssW, H=cssH;
  ctx.clearRect(0,0,W,H);
  const vals=closes.filter(v=>v!=null); if(vals.length<2){ ctx.fillStyle=mutedCol; ctx.font="16px sans-serif"; ctx.fillText("Data grafik belum tersedia",20,40); return; }
  const min=Math.min(...vals), max=Math.max(...vals), pad=(max-min)*0.08||1;
  const lo=min-pad, hi=max+pad;
  ctx.strokeStyle=gridCol; ctx.beginPath();
  for(let i=1;i<5;i++){ const y=H*i/5; ctx.moveTo(0,y); ctx.lineTo(W,y); } ctx.stroke();
  const pts=closes.map((v,i)=> v==null ? null : {x:i/(closes.length-1)*W, y:H-(v-lo)/(hi-lo)*H}).filter(p=>p);
  // Garis oranye (gaya Extej) + gradien oranye muda di bawahnya
  const grad=ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,"rgba(255,122,26,0.22)"); grad.addColorStop(1,"rgba(255,122,26,0)");
  ctx.beginPath();
  pts.forEach((p,i)=>{ i===0?ctx.moveTo(p.x,p.y):ctx.lineTo(p.x,p.y); });
  ctx.strokeStyle="#ff7a1a"; ctx.lineWidth=2; ctx.stroke();
  ctx.lineTo(pts[pts.length-1].x,H); ctx.lineTo(pts[0].x,H); ctx.closePath();
  ctx.fillStyle=grad; ctx.fill();
  // garis MA20 (putus-putus, biru)
  const ma=sma(closes,20); ctx.strokeStyle=blueCol; ctx.setLineDash([5,4]); ctx.beginPath();
  let started=false; ma.forEach((v,i)=>{ if(v==null) return; const x=i/(closes.length-1)*W; const y=H-(v-lo)/(hi-lo)*H; if(!started){ctx.moveTo(x,y);started=true;} else ctx.lineTo(x,y); });
  ctx.stroke(); ctx.setLineDash([]);
}
async function openDetail(code, keep=false){
  selected=code;
  $("#detail").classList.remove("hidden");
  $("#detailTitle").innerHTML = '<span style="display:flex;gap:8px;align-items:center">' + stockLogoHTML(code, 28) + "<span>" + code + " — Detail</span></span>";
  $("#detailNote").textContent = "Memuat grafik…";
  try{
    const r=await fetch(`/api/chart?symbol=${code}.JK&range=${selectedRange}`);
    if(!r.ok) throw new Error("HTTP "+r.status);
    const d=await r.json();
    const closes=d.closes||[];
    lastCloses=closes;
    drawChart($("#chart"), closes);
    const valid=closes.filter(v=>v!=null);
    const ma20=sma(closes,20), ma50=sma(closes,50);
    const lastMA20=ma20.filter(v=>v!=null).pop(), lastMA50=ma50.filter(v=>v!=null).pop();
    const rsiVal=rsi(valid);
    const lo=Math.min(...valid), hi=Math.max(...valid);
    const q=prices[code+".JK"];
    const ai=analyzeStock(code, closes, q);
    analysis[code]=ai;
    renderAiPanel(code, ai);
    renderWatch();
    $("#detailStats").innerHTML = `
      <div><small>Harga terakhir</small><b>${fmtRp(q?.price ?? valid[valid.length-1])}</b></div>
      <div><small>MA20</small><b>${fmtRp(lastMA20)}</b></div>
      <div><small>MA50</small><b>${fmtRp(lastMA50)}</b></div>
      <div><small>RSI (14)</small><b>${rsiVal==null?"—":rsiVal.toFixed(1)+" "+(rsiVal>=70?"(overbought)":rsiVal<=30?"(oversold)":"(netral)")}</b></div>
      <div><small>Tertinggi ${selectedRange}</small><b>${fmtRp(hi)}</b></div>
      <div><small>Terendah ${selectedRange}</small><b>${fmtRp(lo)}</b></div>
      <div><small>Prev close</small><b>${fmtRp(d.previousClose)}</b></div>
      <div><small>Data</small><b>${valid.length} hari bursa</b></div>`;
    $("#detailNote").textContent = "Garis oranye: harga penutupan. Garis biru putus-putus: MA20. MA/RSI dihitung dari data Yahoo Finance di browser kamu.";
    if(!keep) $("#detail").scrollIntoView({behavior:"smooth"});
  }catch(e){ $("#detailNote").textContent="Gagal memuat grafik: "+e.message; renderAiPanel(code, null); }
}

// ---- Alert ----
function renderAlerts(){
  $("#alertCount").textContent = alerts.length ? `(${alerts.length})` : "";
  const sc=$("#alertCountSide"); if(sc) sc.textContent = alerts.length ? `(${alerts.length})` : "";
  const list=$("#alertList"); list.innerHTML="";
  if(!alerts.length){ list.innerHTML='<p class="muted">Belum ada alert. Buat alert harga atau % harian di atas.</p>'; }
  alerts.forEach((a,i)=>{
    const d=document.createElement("div"); d.className="alert-item";
    const desc = a.type==="above" ? `≥ ${fmtRp(a.value)}` : a.type==="below" ? `≤ ${fmtRp(a.value)}` : a.type==="pct_up" ? `naik ≥ ${a.value}% / hari` : `turun ≥ ${a.value}% / hari`;
    d.innerHTML=`<b>${a.code}</b> — ${desc} <button class="del" style="float:right">Hapus</button>`;
    d.querySelector(".del").onclick=()=>{ alerts.splice(i,1); save(LS.alerts,alerts); renderAlerts(); };
    list.appendChild(d);
  });
  const tl=$("#trigList");
  if(!triggered.length){ tl.innerHTML='<p class="muted">Belum ada alert yang terpicu.</p>'; }
  else{
    tl.innerHTML="";
    [...triggered].reverse().slice(0,20).forEach(t=>{
      const d=document.createElement("div"); d.className="trig"; d.textContent=`${t.time} — ${t.text}`; tl.appendChild(d);
    });
    const clear=document.createElement("button"); clear.textContent="Bersihkan riwayat"; clear.onclick=()=>{ triggered=[]; save(LS.trig,triggered); renderAlerts(); }; tl.appendChild(clear);
  }
}
$("#alertForm").addEventListener("submit", e=>{
  e.preventDefault();
  const code=$("#alCode").value.trim().toUpperCase().replace(/\.JK$/,"");
  const value=parseFloat($("#alValue").value);
  if(!/^[A-Z0-9]{2,6}$/.test(code) || isNaN(value)) return alert("Isi kode saham dan nilai alert dengan benar.");
  alerts.push({code, type:$("#alType").value, value});
  save(LS.alerts,alerts);
  $("#alCode").value=""; $("#alValue").value="";
  renderAlerts(); alert("Alert disimpan. Akan dicek setiap refresh.");
});
function fireAlert(text){
  triggered.push({time:new Date().toLocaleString("id-ID",{timeZone:"Asia/Jakarta"}), text});
  save(LS.trig,triggered);
  if("Notification" in window && Notification.permission==="granted"){ try{ new Notification("Alert Saham IDX", {body:text}); }catch(e){} }
}
function checkAlerts(){
  alerts.forEach(a=>{
    const q=prices[a.code+".JK"]; if(!q) return;
    let hit=false, text="";
    if(a.type==="above" && q.price>=a.value){ hit=true; text=`${a.code} ${fmtRp(q.price)} sudah ≥ ${fmtRp(a.value)}`; }
    if(a.type==="below" && q.price<=a.value){ hit=true; text=`${a.code} ${fmtRp(q.price)} sudah ≤ ${fmtRp(a.value)}`; }
    if(a.type==="pct_up" && (q.changePercent||0)>=a.value){ hit=true; text=`${a.code} naik ${fmtPct(q.changePercent)} (≥ ${a.value}%)`; }
    if(a.type==="pct_down" && (q.changePercent||0)<=-a.value){ hit=true; text=`${a.code} turun ${fmtPct(q.changePercent)} (≥ ${a.value}%)`; }
    if(hit){
      const key=a.code+"|"+a.type+"|"+a.value+"|"+new Date().toDateString();
      if(!triggered.some(t=>t.key===key)){ triggered.push({key, time:new Date().toLocaleString("id-ID",{timeZone:"Asia/Jakarta"}), text}); save(LS.trig,triggered); if("Notification" in window && Notification.permission==="granted"){ try{ new Notification("Alert Saham IDX",{body:text}); }catch(e){} } }
    }
  });
  renderAlerts();
}

// ---- Portofolio ----
function renderPortfolio(){
  const body=$("#portBody"); body.innerHTML="";
  let totalVal=0, totalCost=0;
  if(!portfolio.length){ body.innerHTML='<tr><td colspan="6" class="muted">Belum ada posisi. Tambah posisi di atas.</td></tr>'; }
  portfolio.forEach((p,i)=>{
    const q=prices[p.code+".JK"];
    const shares=p.lot*100, cost=shares*p.price, cur=q?shares*q.price:null, pl=cur!=null?cur-cost:null;
    totalVal+=cur||0; totalCost+=cost;
    const tr=document.createElement("tr");
    tr.innerHTML=`<td data-label="Kode"><b>${p.code}</b></td><td data-label="Lot">${p.lot}</td><td data-label="Beli">${fmtRp(p.price)}</td><td data-label="Terakhir">${fmtRp(q?.price)}</td>
      <td data-label="P/L" class="${pl==null?"":pl>=0?"up":"down"}">${pl==null?"—":(pl>=0?"+":"−")+fmtRp(Math.abs(pl))+" ("+fmtPct(cost?pl/cost*100:null)+")"}</td>
      <td class="cell-action"><button class="del">✕</button></td>`;
    tr.querySelector(".del").onclick=()=>{ portfolio.splice(i,1); save(LS.port,portfolio); renderPortfolio(); };
    body.appendChild(tr);
  });
  const tpl=totalVal-totalCost;
  $("#portTotal").textContent = portfolio.length ? `${fmtRp(totalVal)} • P/L ${tpl>=0?"+":"−"}${fmtRp(Math.abs(tpl))}` : "—";
}
$("#portForm").addEventListener("submit", e=>{
  e.preventDefault();
  const code=$("#pfCode").value.trim().toUpperCase().replace(/\.JK$/,"");
  const lot=parseInt($("#pfLot").value,10), price=parseFloat($("#pfPrice").value);
  if(!/^[A-Z0-9]{2,6}$/.test(code) || !lot || isNaN(price)) return alert("Isi kode, lot, dan harga beli dengan benar.");
  portfolio.push({code, lot, price}); save(LS.port,portfolio);
  $("#pfCode").value=""; $("#pfLot").value=""; $("#pfPrice").value="";
  renderPortfolio();
});

