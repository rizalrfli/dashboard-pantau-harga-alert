---
import "../styles/global.css";
---

<!doctype html>
<html lang="id" data-type="software">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Masuk — Screener AI</title>
    <meta name="description" content="Masuk ke dashboard Pantau Saham IDX." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="login-page">
<main class="login-card">
  <div class="logo"><span class="logo-mark">S</span><div><b>Screener AI</b><span>Pantau Saham IDX</span></div></div>
  <h1>Masuk ke dashboard</h1>
  <p class="sub">Halaman ini dikunci — masukkan password untuk melanjutkan.</p>

  <p id="loginError" class="err hidden">Password salah. Coba lagi.</p>
  <form id="loginForm">
    <label for="password">Password</label>
    <input id="password" type="password" autocomplete="current-password" autofocus>
    <button type="submit">Masuk</button>
  </form>

  <details class="change">
    <summary>Ganti password</summary>
    <p id="changeError" class="err hidden">Password lama salah.</p>
    <p id="changeOk" class="ok hidden">Hash baru dibuat. Tempel hash di bawah ke <b>PASSWORD_HASH</b> di <b>auth.js</b>, lalu push ulang ke GitHub — password baru aktif setelah Vercel redeploy.</p>
    <form id="changeForm">
      <div class="field"><label for="oldPass">Password lama</label><input id="oldPass" type="password" autocomplete="current-password"></div>
      <div class="field"><label for="newPass">Password baru</label><input id="newPass" type="password" autocomplete="new-password"></div>
      <button type="submit" class="secondary">Buat hash baru</button>
    </form>
    <div id="hashOut" class="hash-out hidden"></div>
    <button id="copyHash" type="button" class="secondary hidden">Salin hash</button>
    <p class="note">Yang ditampilkan hanya hash SHA-256, bukan passwordnya. Hash lama di auth.js tetap berlaku sampai kamu menggantinya dan redeploy.</p>
  </details>

  <section class="history" id="loginHistory">
    <h2>Riwayat Login</h2>
    <p class="note">Riwayat tersimpan di Supabase.</p>
    <p id="historyEmpty" class="note hidden">Belum ada riwayat login.</p>
    <p id="historyUnavailable" class="note hidden">Riwayat login belum tersedia — env Supabase belum diatur di Vercel.</p>
    <p id="historyError" class="note hidden">Riwayat login tidak bisa dimuat saat ini.</p>
    <ul id="historyList" class="history-list hidden"></ul>
  </section>

  <footer>Data dari Yahoo Finance, bisa delay ~15 menit. Bukan rekomendasi investasi.</footer>
</main>

    <script>
import { sha256Hex, PASSWORD_HASH, isLoggedIn, SESSION_KEY, logLoginAttempt } from "../lib/auth.js";

(function () {
  var params = new URLSearchParams(location.search);
  var next = params.get("next") || "index.html";
  // Hanya izinkan redirect internal, jangan ke situs lain.
  if (!/^(index\.html|analisa\.html)/.test(next)) next = "index.html";

  // Kalau sudah login, langsung lanjut — tidak perlu login dua kali.
  if (isLoggedIn()) { location.replace(next); return; }

  document.getElementById("loginForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var pw = document.getElementById("password").value;
    if (pw && sha256Hex(pw) === PASSWORD_HASH) {
      logLoginAttempt(true); // fire-and-forget, tidak menunda redirect
      try { sessionStorage.setItem(SESSION_KEY, "1"); } catch (err) {}
      location.replace(next);
    } else {
      logLoginAttempt(false);
      document.getElementById("loginError").classList.remove("hidden");
      document.getElementById("password").value = "";
      document.getElementById("password").focus();
    }
  });

  // Riwayat login dari Supabase (lewat /api/login-history).
  // User agent diringkas jadi label perangkat/browser; semua teks dimasukkan
  // lewat textContent (bukan innerHTML) karena user_agent adalah input
  // yang dikendalikan siapa pun yang mencoba login.
  function shortUA(ua) {
    ua = String(ua || "");
    var device = /Android/i.test(ua) ? "Android"
      : /iPhone|iPad/i.test(ua) ? "iPhone/iPad"
      : /Windows/i.test(ua) ? "Windows"
      : /Macintosh|Mac OS X/i.test(ua) ? "Mac"
      : /Linux/i.test(ua) ? "Linux" : "Perangkat lain";
    var browser = /Edg\//i.test(ua) ? "Edge"
      : /Chrome\//i.test(ua) ? "Chrome"
      : /Firefox\//i.test(ua) ? "Firefox"
      : /Safari\//i.test(ua) ? "Safari" : "Browser lain";
    return device + " · " + browser;
  }

  function fmtWIB(iso) {
    try {
      return new Date(iso).toLocaleString("id-ID", {
        timeZone: "Asia/Jakarta",
        day: "2-digit", month: "short", year: "numeric",
        hour: "2-digit", minute: "2-digit",
      }) + " WIB";
    } catch (err) { return String(iso || "—"); }
  }

  (function loadHistory() {
    var list = document.getElementById("historyList");
    var emptyEl = document.getElementById("historyEmpty");
    var unavailEl = document.getElementById("historyUnavailable");
    var errEl = document.getElementById("historyError");
    fetch("/api/login-history")
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || data.configured === false) {
          unavailEl.classList.remove("hidden");
          return;
        }
        var rows = Array.isArray(data.rows) ? data.rows.slice(0, 10) : [];
        if (!rows.length) { emptyEl.classList.remove("hidden"); return; }
        rows.forEach(function (row) {
          var li = document.createElement("li");
          var t = document.createElement("div");
          t.className = "t";
          t.textContent = fmtWIB(row.logged_in_at);
          var d = document.createElement("div");
          d.className = "d";
          d.textContent = shortUA(row.user_agent) + (row.ip ? " · " + row.ip : "");
          var s = document.createElement("div");
          s.className = "d " + (row.success ? "good" : "bad");
          s.textContent = row.success ? "Berhasil" : "Gagal";
          li.appendChild(t); li.appendChild(d); li.appendChild(s);
          list.appendChild(li);
        });
        list.classList.remove("hidden");
      })
      .catch(function () { errEl.classList.remove("hidden"); });
  })();

  document.getElementById("changeForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var oldPw = document.getElementById("oldPass").value;
    var newPw = document.getElementById("newPass").value;
    var errEl = document.getElementById("changeError");
    var okEl = document.getElementById("changeOk");
    errEl.classList.add("hidden"); okEl.classList.add("hidden");
    if (!oldPw || sha256Hex(oldPw) !== PASSWORD_HASH) {
      errEl.classList.remove("hidden");
      return;
    }
    if (!newPw || newPw.length < 4) {
      errEl.textContent = "Password baru minimal 4 karakter — pakai yang lebih panjang supaya aman.";
      errEl.classList.remove("hidden");
      return;
    }
    var hash = sha256Hex(newPw);
    var out = document.getElementById("hashOut");
    out.textContent = hash;
    out.classList.remove("hidden");
    document.getElementById("copyHash").classList.remove("hidden");
    okEl.classList.remove("hidden");
    document.getElementById("newPass").value = "";
    document.getElementById("oldPass").value = "";
  });

  document.getElementById("copyHash").addEventListener("click", function () {
    var hash = document.getElementById("hashOut").textContent;
    if (navigator.clipboard) navigator.clipboard.writeText(hash);
  });
})();

    </script>
  </body>
</html>
